const PORT=9339;
const chrome = spawn(CHROME,['--headless=new','--remote-debugging-port='+PORT,'--no-sandbox','--enable-unsafe-swiftshader','--use-gl=angle','--use-angle=swiftshader','--window-size=1280,760','--hide-scrollbars','--user-data-dir='+here+'/test/.chrome-profile3','file://'+here+'/hangang-city.html'],{stdio:'ignore'});
async function tgt(){for(let i=0;i<60;i++){try{const r=await fetch('http://127.0.0.1:'+PORT+'/json/list');const l=await r.json();const p=l.find(t=>t.type==='page'&&t.url.startsWith('file://'));if(p)return p;}catch(e){}await sleep(250);}throw new Error('x');}
const t=await tgt();const ws=new WebSocket(t.webSocketDebuggerUrl);let id=0;const pend=new Map();
ws.addEventListener('message',ev=>{const m=JSON.parse(ev.data);if(m.id&&pend.has(m.id)){pend.get(m.id)(m);pend.delete(m.id);}});
await new Promise(r=>ws.addEventListener('open',r));
const send=(method,params)=>{const mid=++id;return new Promise(res=>{pend.set(mid,res);ws.send(JSON.stringify({id:mid,method,params}));});};
const ev=async e=>{const r=await send('Runtime.evaluate',{expression:e,returnByValue:true});return r.result&&r.result.result?r.result.result.value:undefined;};
