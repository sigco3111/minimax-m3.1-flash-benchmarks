  return 'none'})()`);
console.log('sign', info);
const o=JSON.parse(info);
const nx=Math.sin(o.rot), nz=Math.cos(o.rot);
const cx=o.x+nx*11, cz=o.z+nz*11;
const yaw=Math.atan2(-nx,-nz);
await ev(`(function(){var g=window.__game,d=g.dbg;g.test.setTime(132);g.test.teleport(${cx},${cz});g.test.step(0.3);d.CAMERA.yaw=${yaw};d.CAMERA.pitch=0.05;})()`);
await sleep(1400);
const shot=await send('Page.captureScreenshot',{format:'png'});
writeFileSync(here+'/test/shots/13-neon.png',Buffer.from(shot.result.data,'base64'));
console.log('ok');
ws.close();chrome.kill('SIGKILL');process.exit(0);
