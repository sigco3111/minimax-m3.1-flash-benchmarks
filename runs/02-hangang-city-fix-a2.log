+  if (!c) return '';
+  let m = /^key([a-z])$/.exec(c);            // 'KeyW' → 'w'
+  if (m) return m[1];
+  m = /^digit(\d)$/.exec(c);                  // 'Digit1' → '1'
+  if (m) return m[1];
+  m = /^numpad(\d)$/.exec(c);                 // 'Numpad0' → '0'
+  if (m) return m[1];
+  if (c === 'space' || c === 'spacebar' || c === ' ') return ' ';
