await run('keyDown no location', {type:'keyDown', code:'ShiftLeft', ...base}, false);
await run('rawKeyDown+loc + focusEmu', {type:'rawKeyDown', code:'ShiftLeft', ...base, location:1}, true);
process.exit(0);
EOF
