import { spawn } from 'node:child_process';
import { setTimeout as sleep } from 'node:timers/promises';
const FILE = 'file:///Users/hjshin/work/실험/minimax-m3.1-flash-benchmarks/hangang-city.html';
const CHROME = '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';

async function run(label, params, focusEmu) {
  const PORT = 9342 + Math.floor(Math.random()*100);
  const chrome = spawn(CHROME, ['--headless=new','--remote-debugging-port='+PORT,'--no-sandbox','--enable-unsafe-swiftshader','--use-gl=angle','--use-angle=swiftshader','--user-data-dir=/tmp/.cp-dbg6-'+PORT,FILE],{stdio:['ignore','ignore','ignore']});
  async function getTarget(){for(let i=0;i<60;i++){try{const r=await fetch('http://127.0.0.1:'+PORT+'/json/list');const l=await r.json();const p=l.find(t=>t.type==='page'&&t.url.startsWith('file://'));if(p)return p;}catch(e){}await sleep(250);}throw new Error('no target');}
  const t=await getTarget();const ws=new WebSocket(t.webSocketDebuggerUrl);let id=0;const pending=new Map();
  ws.addEventListener('message',ev=>{const m=JSON.parse(ev.data);if(m.id&&pending.has(m.id)){pending.get(m.id)(m);pending.delete(m.id);}});
  await new Promise(r=>ws.addEventListener('open',r));
  const send=(method,p)=>{const mid=++id;return new Promise(res=>{pending.set(mid,res);ws.send(JSON.stringify({id:mid,method:p}));});};
  const ev=async(e)=>{const r=await send('Runtime.evaluate',{expression:e,returnByValue:true});return r.result?.result?.value;};
  await send('Runtime.enable');
  for(let i=0;i<60;i++){if(await ev('!!window.__game'))break;await sleep(250);}
  await sleep(400);
  if (focusEmu) await send('Emulation.setFocusEmulationEnabled',{enabled:true});
  await ev(`window.__b=0;window.addEventListener('blur',()=>{window.__b++;});`);
  await send('Input.dispatchKeyEvent',params);
  await sleep(300);
  const out = await ev('({blurs:window.__b,down:JSON.parse(JSON.stringify(window.__game.dbg.INPUT.down)),vis:document.visibilityState})');
  console.log(label.padEnd(34), JSON.stringify(out));
  ws.close();chrome.kill('SIGKILL');await sleep(200);
}

