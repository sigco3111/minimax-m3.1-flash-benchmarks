+  if (c.startsWith('control') || c === 'ctrl') return 'ctrl';
+  if (c.startsWith('alt')) return 'alt';
+  if (c.startsWith('meta')) return 'meta';
+  return c;                                   // 'arrowup', 'escape', 'w', …
 }
+/* 후보들(e.code, e.key) 중 게임 조작에 해당하는 물리 키 토큰을 찾는다. */
