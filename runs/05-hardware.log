import re
s=open('qtpy.svg',encoding='utf-8',errors='ignore').read()
# find groups with transform and collect text inside
groups=[]
for m in re.finditer(r'<g\b([^>]*)>', s):
    attrs=m.group(1)
    tr=re.search(r'translate\(\s*([-\d.]+)[ ,]+([-\d.]+)',attrs)
    start=m.end()
    # find matching close by counting nested g
    depth=1; i=start
    while depth>0:
        nxt=re.search(r'<g\b|</g>', s[start:])
        break
    # simpler: split document by <g ...> blocks using a stack
# stack-based parse
tokens=re.finditer(r'<(/?)g\b([^>]*)>', s)
stack=[]
out=[]
pos=0
for m in tokens:
    if m.group(1)=='':
        tr=re.search(r'translate\(\s*([-\d.]+)[ ,]+([-\d.]+)', m.group(2))
        stack.append((float(tr.group(1)) if tr else 0.0, float(tr.group(2)) if tr else 0.0))
    else:
        if stack: stack.pop()
# Instead: for each text, walk backwards to nearest preceding <g ...> with translate
txts=[]
for m in re.finditer(r'<text\b([^>]*)>(.*?)</text>', s, re.S):
    attrs=m.group(1)
    body=m.group(2)
    t=' '.join(re.sub(r'<[^>]+>','',body).split())
    if not t: continue
    x=re.search(r'x="([-\d.]+)"',attrs); y=re.search(r'y="([-\d.]+)"',attrs)
    if x and y:
        txts.append((float(x.group(1)), float(y.group(1)), t, m.start()))
    else:
        txts.append((None,None,t,m.start()))
print('texts with xy:', sum(1 for t in txts if t[0] is not None), 'of', len(txts))
# build group transform map by scanning
gmap={}
depth_stack=[]
i=0
events=sorted([(m.start(), 'open', m.group(2)) for m in re.finditer(r'<g\b([^>]*)>', s)] +
               [(m.start(), 'close', '') for m in re.finditer(r'</g>', s)])
cur=[]
for pos,kind,attrs in events:
    if kind=='open':
        tr=re.search(r'translate\(\s*([-\d.]+)[ ,]+([-\d.]+)',attrs)
        cur.append((float(tr.group(1)) if tr else 0.0, float(tr.group(2)) if tr else 0.0))
    else:
        if cur:
            gmap[pos]=cur[-1]; cur.pop()
for x,y,t,p in txts:
    if x is None:
        # find last gmap entry before p
        cand=[v for k,v in gmap.items() if k<p]
        gx,gy = cand[-1] if cand else (0,0)
    else:
        gx,gy=x,y
    print(f"{gx:8.1f} {gy:8.1f}  {t}")
