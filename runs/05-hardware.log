import re
s=open('qtpy.svg',encoding='utf-8',errors='ignore').read()
# remove tags but keep element boundaries with coords
elems=[]
for m in re.finditer(r'<(text|tspan|g)\b([^>]*)>', s):
    tag=m.group(1); attrs=m.group(2)
    elems.append((tag,attrs,m.start()))
texts=[]
for i,(tag,attrs,pos) in enumerate(elems):
    if tag!='text': continue
    end=s.find('</text>',pos)
    body=s[pos:end]
    txt=re.sub(r'<[^>]+>','',body)
    txt=' '.join(txt.split())
    x=re.search(r'\bx="([-\d.]+)"',attrs); y=re.search(r'\by="([-\d.]+)"',attrs)
    if txt:
        texts.append((float(x.group(1)) if x else -1, float(y.group(1)) if y else -1, txt))
print("total texts",len(texts))
# cluster by x (column) then sort by y
from collections import defaultdict
cols=defaultdict(list)
for x,y,t in texts: cols[round(x/10)*10].append((y,t))
for cx in sorted(cols):
    items=sorted(cols[cx])
    print(f"--- x~{cx} ({len(items)}) ---")
    print(" | ".join(f"{t}@{y:.0f}" for y,t in items))
EOF
