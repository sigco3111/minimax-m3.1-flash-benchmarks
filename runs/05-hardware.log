# For each header pad, find routed wire endpoint to derive y
for hdr,xc in (('JP1',1.27),('JP3',16.51)):
    print("==",hdr)
    for s in b.find('signals').findall('signal'):
        refs=[c.get('pad') for c in s.findall('contactref') if c.get('element')==hdr]
        if not refs: continue
        ys=set()
        for w in s.findall('wire'):
            for k1,k2 in (('x1','y1'),('x2','y2')):
                if abs(float(w.get(k1))-xc)<0.01:
                    ys.add(float(w.get(k2)))
        for c in s.findall('contactref'):
            if c.get('element')==hdr:
                print(f"   pad {c.get('pad'):4s} net={s.get('name'):10s} wire_y={sorted(ys)}")
