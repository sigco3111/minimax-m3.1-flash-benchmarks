import xml.etree.ElementTree as ET
r=ET.parse('qtpy.brd').getroot()
b=r.find('drawing').find('board')
print("board children:", [c.tag for c in list(b)])
# layers
layers={l.get('number'):l.get('name') for l in r.find('drawing').find('layers')}
def layer_name(n):
    return layers.get(n,n)
# board outline from wires on Dimension/Dimensions/tPlace layers
for lay in ('Dimension','Dimensions','tPlace','tDocu','tSilk','tNames','tKeepout','Document'):
    ws=b.find('plain').findall('wire')
    xs=[];ys=[]
    for w in ws:
        if w.get('layer')==lay:
            for k in ('x1','x2'): xs.append(float(w.get(k)))
            for k in ('y1','y2'): ys.append(float(w.get(k)))
    if xs:
        print(f"layer {lay}: bbox x[{min(xs):.3f},{max(xs):.3f}] y[{min(ys):.3f},{max(ys):.3f}] w={max(xs)-min(xs):.3f} h={max(ys)-min(ys):.3f}")
# elements with silkscreen text
els=b.find('elements')
print("elements:",len(els.findall('element')))
rows=[]
for e in els.findall('element'):
    name=e.get('name'); pkg=e.get('package'); val=e.get('value'); x=float(e.get('x')); y=float(e.get('y'))
    rot=e.get('rot')
    texts=[(t.text, t.get('x'), t.get('y'), t.get('size'), t.get('font'), t.get('ratio')) for t in e.findall('text')]
    rows.append((name,pkg,val,x,y,rot,texts))
for name,pkg,val,x,y,rot,texts in rows:
    if texts:
        print(f"{name:5s} pkg={pkg:16s} x={x:8.2f} y={y:8.2f} rot={rot} val={val!r} texts={texts}")
EOF
