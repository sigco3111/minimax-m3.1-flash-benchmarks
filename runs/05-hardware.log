import re
s=open('qtpy.svg',encoding='utf-8',errors='ignore').read()
tok=re.compile(r'<g\b([^>]*)>|</g>|<text\b([^>]*)>(.*?)</text>', re.S)
stack=[]
rows=[]
for m in tok.finditer(s):
    if m.group(0).startswith('<g'):
        tr=re.search(r'translate\(\s*([-\d.]+)[ ,]+([-\d.]+)', m.group(1))
        stack.append((float(tr.group(1)) if tr else 0.0, float(tr.group(2)) if tr else 0.0))
    elif m.group(0)=='</g>':
        if stack: stack.pop()
    else:
        t=' '.join(re.sub(r'<[^>]+>','',m.group(3)).split())
        if not t: continue
        gx=sum(a for a,b in stack); gy=sum(b for a,b in stack)
        rows.append((gx,gy,t))
print(len(rows))
for gx,gy,t in rows:
    print(f"{gx:9.2f} {gy:9.2f}  {t}")
EOF
