echo "== search all rp2040 =="; "$TOOLS/arduino-cli" core search --all rp2040 2>&1 | head -10
echo "== package index json grep =="
python3 - <<'EOF'
import json,glob
for f in glob.glob('/private/var/folders/5z/khzkzvw94_j68xs6_4sthpwh0000gn/T/opencode/tools/arduino-data/package_*.json'):
    try:
        d=json.load(open(f))
    except Exception as e:
        print(f,e); continue
    pk=d.get('packages',[])
    print(f, [p.get('name') for p in pk][:20])
    for p in pk:
        if 'rp2040' in p.get('name','').lower() or any('rp2040' in (pl.get('name','')+pl.get('architecture','')).lower() for pl in p.get('platforms',[])):
            print('  ->', p.get('name'), [(pl.get('name'),pl.get('architecture'),pl.get('version')) for pl in p.get('platforms',[])])
EOF
