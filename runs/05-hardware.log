import xml.etree.ElementTree as ET
r=ET.parse('qtpy.brd').getroot()
b=r.find('drawing').find('board')
sigs=b.find('signals')
def num(e,k):
    v=e.get(k); return float(v) if v not in (None,'') else None
rows=[]
for s in sigs.findall('signal'):
    name=s.get('name')
    for w in s.findall('wire'):
        for p in w.findall('pad'):
            rows.append((name,p.get('ref'),num(p,'x'),num(p,'y')))
    for c in s.findall('contactref'):
        rows.append((name,c.get('ref'),num(c,'x1'),num(c,'y1')))
out=[r for r in rows if r[1] in ('JP1','JP3','CONN1')]
for name,ref,x,y in sorted(out, key=lambda r:(r[1], -(r[3] or 0), r[2] or 0)):
    print(f"{ref:6s} net={name!r:26s} x={x} y={y}")
EOF
