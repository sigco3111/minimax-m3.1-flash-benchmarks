import re, urllib.request, urllib.parse
def search(q):
    url="https://www.adafruit.com/search?q="+urllib.parse.quote(q)
    req=urllib.request.Request(url, headers={'User-Agent':'Mozilla/5.0 (Macintosh)'})
    h=urllib.request.urlopen(req, timeout=25).read().decode('utf-8','ignore')
    seen=set(); out=[]
    for m in re.finditer(r'href="/?product/(\d+)"[^>]*>(.{0,160}?)</a>', h, re.S|re.I):
        t=' '.join(re.sub(r'<[^>]+>','',m.group(2)).split())
        if t and (m.group(1),t) not in seen:
            seen.add((m.group(1),t)); out.append((m.group(1),t))
    print(f"### {q}")
    for i,t in out[:6]: print("   ",i,"|",t[:80])
for q in ["6mm tactile switch","3mm red LED","330 ohm resistor","M3 nylon screw","USB-C to USB-C cable","STEMMA QT 4-pin cable"]:
    try: search(q)
    except Exception as e: print(q,"ERR",e)
