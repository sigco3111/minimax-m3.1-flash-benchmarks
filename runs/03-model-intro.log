import { spawn } from 'node:child_process'
import os from 'node:os'; import path from 'node:path'; import fs from 'node:fs'
const CHROME='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
const url=process.argv[2]; const port=9933
fs.mkdirSync('.dev/shots3',{recursive:true})
const chrome=spawn(CHROME,['--headless=new',`--remote-debugging-port=${port}`,`--user-data-dir=${path.join(os.tmpdir(),'cdp-'+port)}`,'--no-first-run','--window-size=390,844','--force-device-scale-factor=2','--hide-scrollbars',url],{stdio:'ignore'})
const sleep=ms=>new Promise(r=>setTimeout(r,ms)); let id=0
function rpc(ws,m,p){return new Promise((res,rej)=>{const mid=++id;const h=e=>{const m2=JSON.parse(e.data);if(m2.id===mid){ws.removeEventListener('message',h);m2.error?rej(new Error(JSON.stringify(m2.error))):res(m2.result)}};ws.addEventListener('message',h);ws.send(JSON.stringify({id:mid,method:m,params:p}))})}
let list=null; for(let i=0;i<60;i++){try{list=await (await fetch(`http://127.0.0.1:${port}/json/list`)).json();if(list.some(t=>t.type==='page'))break}catch{} await sleep(250)}
const page=list.find(t=>t.type==='page'); const ws=new WebSocket(page.webSocketDebuggerUrl)
await new Promise((r,j)=>{ws.addEventListener('open',r);ws.addEventListener('error',j)})
await rpc(ws,'Runtime.enable'); await rpc(ws,'Page.enable'); await sleep(4500)
const ev=async e=>(await rpc(ws,'Runtime.evaluate',{expression:e,awaitPromise:true,returnByValue:true})).result.value
for (const [u,n] of [[0.2,'m-top'],[2.6,'m-code'],[5.6,'m-ask']]) {
  await ev(`window.scrollTo({top: innerHeight*${u}, behavior:'auto'})`); await sleep(2000)
  const s=await rpc(ws,'Page.captureScreenshot',{format:'png'})
  fs.writeFileSync('.dev/shots3/'+n+'.png', Buffer.from(s.data,'base64'))
}
console.log(await ev(`JSON.stringify(window.__intro.state)`))
chrome.kill('SIGKILL'); process.exit(0)
EOF
