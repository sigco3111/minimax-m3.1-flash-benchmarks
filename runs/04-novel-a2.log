from html.parser import HTMLParser
class P(HTMLParser):
    def __init__(self):
        super().__init__(); self.stack=[]; self.err=[]
    def handle_starttag(self,tag,attrs):
        if tag not in ('meta','br','hr','img','link','input'): self.stack.append(tag)
    def handle_endtag(self,tag):
        if not self.stack or self.stack[-1]!=tag: self.err.append((tag,list(self.stack[-3:])))
        else: self.stack.pop()
h=open('novel.html',encoding='utf-8').read()
p=P(); p.feed(h)
print('unclosed:',p.stack,'errors:',p.err[:5])
import re
print('h1:',re.findall(r'<h1>(.*?)</h1>',h))
print('blockquote count:',h.count('<blockquote>'))
print('last 200 chars:',h.strip()[-200:])
