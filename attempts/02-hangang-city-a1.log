+/* 건물에 막히지 않는 평지 스폰 지점 찾기 */
+function findSpawn(x0, z0) {
+  const q = [];
+  for (let r = 0; r < 30; r++) {
+    for (let a = 0; a < 14; a++) {
+      const ang = a / 14 * TAU;
+      const x = x0 + Math.cos(ang) * r * 6;
+      const z = z0 + Math.sin(ang) * r * 6;
+      if (Math.abs(x) > CFG.half - 24 || Math.abs(z) > CFG.half - 24) continue;
+      if (groundHeight(x, z) !== 0) continue;
+      Solid.query(x, z, 1.4, q);
+      let blocked = false;
+      for (const b of q) {
+        if (b.kind !== 'building') continue;
+        if (x > b.x0 - 1.2 && x < b.x1 + 1.2 && z > b.z0 - 1.2 && z < b.z1 + 1.2) { blocked = true; break; }
+      }
+      if (!blocked) return { x, z };
+    }
+  }
+  return { x: x0, z: z0 };
+}
